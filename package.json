{
  "name": "@hackettyam/api-middleware",
  "version": "0.1.0",
  "description": "Middleware for RESTful APIs in Next.js with support for authentication, validation, and error handling",
  "author": "HackettYam <contact@hackettyam.com>",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/hackettyam/api-middleware"
  },
  "homepage": "https://github.com/hackettyam/api-middleware#readme",
  "bugs": {
    "url": "https://github.com/hackettyam/api-middleware/issues"
  },
  "packageManager": "pnpm@10.8.0",
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc",
    "lint": "eslint src --ext .ts,.tsx,",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky",
    "version": "node scripts/version/index.js",
    "version:minor": "node scripts/version/index.js minor",
    "version:major": "node scripts/version/index.js major",
    "version:patch": "node scripts/version/index.js patch",
    "version:changelog": "node scripts/version/index.js changelog",
    "version:tag": "node scripts/version/index.js tag",
    "release": "node scripts/release/index.js",
    "release:prepare": "node scripts/release/index.js prepare",
    "release:start": "node scripts/release/index.js start",
    "release:finish": "node scripts/release/index.js finish",
    "release:validate": "node scripts/release/index.js validate",
    "release:revert": "node scripts/release/index.js revert",
    "git": "node scripts/git/index.js",
    "feature": "node scripts/git/index.js feature",
    "feature:start": "node scripts/git/index.js feature start",
    "feature:finish": "node scripts/git/index.js feature finish",
    "hotfix": "node scripts/git/index.js hotfix",
    "hotfix:start": "node scripts/git/index.js hotfix start",
    "hotfix:prepare": "node scripts/git/index.js hotfix prepare"
  },
  "keywords": [
    "nextjs",
    "middleware",
    "api",
    "rest",
    "typescript",
    "authentication",
    "validation",
    "error-handling",
    "rate-limiting",
    "http",
    "server"
  ],
  "dependencies": {
    "zod": "^3.22.4"
  },
  "peerDependencies": {
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.0.3",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.27.0",
    "@next/eslint-plugin-next": "^15.3.2",
    "@types/node": "^22.15.19",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "@vitest/coverage-v8": "3.1.4",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "next": "^15.3.2",
    "prettier": "^3.5.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "standard-version": "^9.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
